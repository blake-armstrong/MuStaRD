##############################################################################################
# Coulombic interaction
pair_coeff      *      *  coul/long

#########################################################################################################
# Parameters for reciprocal space electrostatics
#########################################################################################################

kspace_style pppm 1.0e-5
kspace_modify fftbench no
fix ext all external pf/array 1
fix_modify ext energy no
fix_modify ext virial no
fix ux all store/state 1 xu yu zu
fix md all nve
fix tst all temp/csvr 1500 1500 0.1 59658
timestep 0.001
velocity all create 1500 96681 mom yes dist gaussian
fix com all momentum 100 linear 1 1 1
run 0 pre yes post no
