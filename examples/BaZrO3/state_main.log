##############################################################################################
#### Covalent bonds parameters
##############################################################################################
#@  1   bond types

bond_style harmonic
#@ O1 - H1
bond_coeff   1      23.008000      0.985357

##############################################################################################
# Pair potentials
##############################################################################################

variable rmin  equal  8.
variable rmax  equal 10.

pair_style hybrid/overlay buck/mdf ${rmin} ${rmax} lennard/mdf ${rmin} ${rmax}  coul/cut ${rmax}
pair_style hybrid/overlay buck/mdf 8 ${rmax} lennard/mdf ${rmin} ${rmax}  coul/cut ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf ${rmin} ${rmax}  coul/cut ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 ${rmax}  coul/cut ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 10  coul/cut ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 10  coul/cut 10

