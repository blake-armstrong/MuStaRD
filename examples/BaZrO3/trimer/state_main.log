##############################################################################################
# 12-6 Lennard-Jones potentials
pair_coeff  ${O1}  ${H1}  lennard/mdf    6.391   0.000
pair_coeff  4  ${H1}  lennard/mdf    6.391   0.000
pair_coeff  4  7  lennard/mdf    6.391   0.000
pair_coeff  ${O2}  ${H1}  lennard/mdf    6.391   0.000
pair_coeff  5  ${H1}  lennard/mdf    6.391   0.000
