  0 settings made for charge
set type ${Zr}  charge     4.000000
set type 2  charge     4.000000
Setting atom values ...
  0 settings made for charge
set type ${Y}   charge     3.000000
set type 3   charge     3.000000
Setting atom values ...
  0 settings made for charge
set type ${O1}  charge    -1.308698
set type 4  charge    -1.308698
Setting atom values ...
  1 settings made for charge
set type ${O2}  charge    -2.000000
set type 5  charge    -2.000000
Setting atom values ...
  1 settings made for charge
set type ${O3}  charge    -2.000000
set type 6  charge    -2.000000
Setting atom values ...
  0 settings made for charge
set type ${H1}  charge     0.308698
set type 7  charge     0.308698
Setting atom values ...
  1 settings made for charge

##############################################################################################
#### Covalent bonds parameters
##############################################################################################
#@  1   bond types

bond_style harmonic
#@ O1 - H1
# bond_coeff   1      11.504000      0.985357
bond_coeff   1      23.008000      0.985357

##############################################################################################
# Pair potentials
##############################################################################################

variable rmin  equal  8.
variable rmax  equal 10.

pair_style hybrid/overlay buck/mdf ${rmin} ${rmax} lennard/mdf ${rmin} ${rmax} coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 ${rmax} lennard/mdf ${rmin} ${rmax} coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf ${rmin} ${rmax} coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 ${rmax} coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 10 coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 10 coul/long 10

##############################################################################################
