##############################################################################################
#@ 7   atom types

variable Ba  equal 1
variable Zr  equal 2
variable  Y  equal 3
variable O1  equal 4
variable O2  equal 5
variable O3  equal 6
variable H1  equal 7

##############################################################################################
#### Atoms' masses
##############################################################################################

mass  ${Ba}   137.327
mass  1   137.327
mass  ${Zr}    91.224
mass  2    91.224
mass  ${Y}     88.910
mass  3     88.910
mass  ${O1}    100000
mass  4    100000
# mass  ${O1}    15.996
mass  ${O2}    100000
mass  5    100000
# mass  ${O2}    15.996
mass  ${O3}    15.996
mass  6    15.996
mass  ${H1}     1.008
mass  7     1.008

##############################################################################################
#### Atoms' charges
##############################################################################################

set type ${Ba}  charge     2.000000
set type 1  charge     2.000000
