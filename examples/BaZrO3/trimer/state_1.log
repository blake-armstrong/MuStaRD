pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 ${rmax} coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 10 coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 10 coul/long 10

