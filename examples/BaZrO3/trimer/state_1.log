variable Zr  equal 2
variable  Y  equal 3
variable O1  equal 4
variable O2  equal 5
variable O3  equal 6
variable H1  equal 7

##############################################################################################
#### Atoms' masses
##############################################################################################

mass  ${Ba}   137.327
mass  1   137.327
mass  ${Zr}    91.224
mass  2    91.224
mass  ${Y}     88.910
mass  3     88.910
mass  ${O1}    100000
mass  4    100000
# mass  ${O1}    15.996
mass  ${O2}    100000
mass  5    100000
