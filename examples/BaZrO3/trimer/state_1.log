include ff.lmp
##############################################################################################
#### Atoms' types - mass - charge
##############################################################################################
#@ 7   atom types

variable Ba  equal 1
variable Zr  equal 2
variable  Y  equal 3
variable O1  equal 4
variable O2  equal 5
variable O3  equal 6
variable H1  equal 7

##############################################################################################
#### Atoms' masses
##############################################################################################

mass  ${Ba}   137.327
mass  1   137.327
mass  ${Zr}    91.224
mass  2    91.224
mass  ${Y}     88.910
mass  3     88.910
mass  ${O1}    100000
mass  4    100000
# mass  ${O1}    15.996
mass  ${O2}    100000
mass  5    100000
# mass  ${O2}    15.996
mass  ${O3}    15.996
mass  6    15.996
mass  ${H1}     1.008
mass  7     1.008

##############################################################################################
#### Atoms' charges
##############################################################################################

set type ${Ba}  charge     2.000000
set type 1  charge     2.000000
Setting atom values ...
  0 settings made for charge
set type ${Zr}  charge     4.000000
set type 2  charge     4.000000
Setting atom values ...
  0 settings made for charge
set type ${Y}   charge     3.000000
set type 3   charge     3.000000
Setting atom values ...
  0 settings made for charge
set type ${O1}  charge    -1.308698
set type 4  charge    -1.308698
Setting atom values ...
  1 settings made for charge
set type ${O2}  charge    -2.000000
set type 5  charge    -2.000000
Setting atom values ...
  1 settings made for charge
set type ${O3}  charge    -2.000000
set type 6  charge    -2.000000
Setting atom values ...
  0 settings made for charge
set type ${H1}  charge     0.308698
set type 7  charge     0.308698
Setting atom values ...
  1 settings made for charge

##############################################################################################
#### Covalent bonds parameters
##############################################################################################
#@  1   bond types

bond_style harmonic
#@ O1 - H1
# bond_coeff   1      11.504000      0.985357
bond_coeff   1      23.008000      0.985357

##############################################################################################
# Pair potentials
##############################################################################################

variable rmin  equal  8.
