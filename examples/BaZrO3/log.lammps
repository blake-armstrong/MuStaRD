  216 settings made for charge
set type ${Zr}  charge     4.000000
set type 2  charge     4.000000
Setting atom values ...
  216 settings made for charge
set type ${Y}   charge     3.000000
set type 3   charge     3.000000
Setting atom values ...
  0 settings made for charge
set type ${O1}  charge    -1.308698
set type 4  charge    -1.308698
Setting atom values ...
  1 settings made for charge
set type ${O2}  charge    -2.000000
set type 5  charge    -2.000000
Setting atom values ...
  647 settings made for charge
set type ${O3}  charge    -2.000000
set type 6  charge    -2.000000
Setting atom values ...
  0 settings made for charge
set type ${H1}  charge     0.308698
set type 7  charge     0.308698
Setting atom values ...
  1 settings made for charge

##############################################################################################
#### Covalent bonds parameters
##############################################################################################
#@  1   bond types

bond_style harmonic
#@ O1 - H1
bond_coeff   1      23.008000      0.985357

##############################################################################################
# Pair potentials
##############################################################################################

variable rmin  equal  8.
variable rmax  equal 10.

pair_style hybrid/overlay buck/mdf ${rmin} ${rmax} lennard/mdf ${rmin} ${rmax} coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 ${rmax} lennard/mdf ${rmin} ${rmax} coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf ${rmin} ${rmax} coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 ${rmax} coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 10 coul/long ${rmax}
pair_style hybrid/overlay buck/mdf 8 10 lennard/mdf 8 10 coul/long 10

##############################################################################################
# Buckingham interaction potentials
pair_coeff  ${Ba}  ${O1}  buck/mdf   688.21662   0.392014   0.000
pair_coeff  1  ${O1}  buck/mdf   688.21662   0.392014   0.000
pair_coeff  1  4  buck/mdf   688.21662   0.392014   0.000
pair_coeff  ${Ba}  ${O2}  buck/mdf   972.19945   0.392014   0.000
pair_coeff  1  ${O2}  buck/mdf   972.19945   0.392014   0.000
pair_coeff  1  5  buck/mdf   972.19945   0.392014   0.000
pair_coeff  ${Ba}  ${O3}  buck/mdf   972.19945   0.392014   0.000
pair_coeff  1  ${O3}  buck/mdf   972.19945   0.392014   0.000
pair_coeff  1  6  buck/mdf   972.19945   0.392014   0.000

pair_coeff  ${Y}   ${O1}  buck/mdf   2972.3808   0.267317   0.000
pair_coeff  3   ${O1}  buck/mdf   2972.3808   0.267317   0.000
pair_coeff  3   4  buck/mdf   2972.3808   0.267317   0.000
pair_coeff  ${Y}   ${O2}  buck/mdf   4121.8373   0.280386   0.000
pair_coeff  3   ${O2}  buck/mdf   4121.8373   0.280386   0.000
pair_coeff  3   5  buck/mdf   4121.8373   0.280386   0.000
pair_coeff  ${Y}   ${O3}  buck/mdf   4121.8373   0.280386   0.000
pair_coeff  3   ${O3}  buck/mdf   4121.8373   0.280386   0.000
pair_coeff  3   6  buck/mdf   4121.8373   0.280386   0.000

pair_coeff  ${Zr}  ${O1}  buck/mdf   2195.8712   0.298760   0.000
pair_coeff  2  ${O1}  buck/mdf   2195.8712   0.298760   0.000
