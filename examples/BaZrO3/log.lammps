pair_coeff  ${Zr}  ${O2}  buck/mdf   3250.8545   0.298760   0.000
pair_coeff  2  ${O2}  buck/mdf   3250.8545   0.298760   0.000
pair_coeff  2  5  buck/mdf   3250.8545   0.298760   0.000
pair_coeff  ${Zr}  ${O3}  buck/mdf   3250.8545   0.298760   0.000
pair_coeff  2  ${O3}  buck/mdf   3250.8545   0.298760   0.000
pair_coeff  2  6  buck/mdf   3250.8545   0.298760   0.000

pair_coeff  ${O1}  ${O1}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  4  ${O1}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  4  4  buck/mdf   22764.000   0.149000   0.000
pair_coeff  ${O1}  ${O2}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  4  ${O2}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  4  5  buck/mdf   22764.000   0.149000   0.000
pair_coeff  ${O1}  ${O3}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  4  ${O3}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  4  6  buck/mdf   22764.000   0.149000   0.000

pair_coeff  ${O2}  ${O2}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  5  ${O2}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  5  5  buck/mdf   22764.000   0.149000   0.000
pair_coeff  ${O2}  ${O3}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  5  ${O3}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  5  6  buck/mdf   22764.000   0.149000   0.000

pair_coeff  ${O3}  ${O3}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  6  ${O3}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  6  6  buck/mdf   22764.000   0.149000   0.000

##############################################################################################
# 12-6 Lennard-Jones potentials
pair_coeff  ${O1}  ${H1}  lennard/mdf    6.391   0.000
pair_coeff  4  ${H1}  lennard/mdf    6.391   0.000
pair_coeff  4  7  lennard/mdf    6.391   0.000
pair_coeff  ${O2}  ${H1}  lennard/mdf    6.391   0.000
pair_coeff  5  ${H1}  lennard/mdf    6.391   0.000
pair_coeff  5  7  lennard/mdf    6.391   0.000
pair_coeff  ${O3}  ${H1}  lennard/mdf    7.800   0.000
pair_coeff  6  ${H1}  lennard/mdf    7.800   0.000
pair_coeff  6  7  lennard/mdf    7.800   0.000

##############################################################################################
# Coulombic interaction
pair_coeff      *      *  coul/long

#########################################################################################################
# Parameters for reciprocal space electrostatics
#########################################################################################################

kspace_style pppm 1.0e-5
kspace_modify fftbench no

# ------ Group definitions -------------------------

# ------ Energy minimisation -----------------------
if "${runID} > 0" then "jump SELF end_minimise"
if "${minimisation} == no && ${relax_cell} == no" then "jump SELF end_minimise"
jump SELF end_minimise

# ------ PLUMED ------------------------------------
if "${plumed} == no" then "jump SELF end_plumed"
jump SELF end_plumed

# ------ Ensemble ----------------------------------
group free id > 0
1081 atoms in group free
variable fixAtoms string "all"

# nve/nph
if "${ens} == nve"                  then "fix md ${fixAtoms} nve"
if "${ens} == nph"                  then "fix md ${fixAtoms} nph ${npttype} ${pres} ${pres} ${prel} tchain 5 pchain 5 mtk yes"
if "${ens} == nph || ${ens} == nve" then "jump SELF end_ensemble"
# Nose-Hoover
if "${ens} == nvt && ${tst} == nh"  then "fix tst ${fixAtoms} nvt temp ${temp} ${temp} ${trel} tchain 5"
if "${ens} == npt && ${tst} == nh"  then "fix tst ${fixAtoms} npt temp ${temp} ${temp} ${trel} ${npttype} ${pres} ${pres} ${prel} tchain 5 pchain 5 mtk yes"
# Other thermostats
if "${ens} == nvt && ${tst} != nh"  then "fix md ${fixAtoms} nve"
fix md ${fixAtoms} nve
fix md all nve
if "${ens} == npt && ${tst} != nh"  then "fix md ${fixAtoms} nph ${npttype} ${pres} ${pres} ${prel} tchain 5 pchain 5 mtk yes"
if "${tst} == ber"                  then "fix tst ${fixAtoms} temp/berendsen ${temp} ${temp} ${trel}"
if "${tst} == lang"                 then "fix tst ${fixAtoms} langevin ${temp} ${temp} ${trel} ${iseed1} tally yes zero yes"
if "${tst} == csvr"                 then "fix tst ${fixAtoms} temp/csvr ${temp} ${temp} ${trel} ${iseed1}"
fix tst ${fixAtoms} temp/csvr ${temp} ${temp} ${trel} ${iseed1}
fix tst all temp/csvr ${temp} ${temp} ${trel} ${iseed1}
fix tst all temp/csvr 1500. ${temp} ${trel} ${iseed1}
fix tst all temp/csvr 1500. 1500. ${trel} ${iseed1}
fix tst all temp/csvr 1500. 1500. 0.1 ${iseed1}
fix tst all temp/csvr 1500. 1500. 0.1 96248
label end_ensemble

variable myTemp string "temp"
if "${fixAtoms} == all" then "jump SELF end_temp"
jump SELF end_temp

# ------ Thermodynamic output ----------------------
variable str_basic string 'step time pe ${myTemp} press cella cellb cellc cellalpha cellbeta cellgamma'
step time pe temp press cella cellb cellc cellalpha cellbeta cellgamma

# ------ Use target pressure for the Enthalpy ------
variable pv2h equal 1602191.7 # for metal units
variable enth equal etotal+${pres}*vol/${pv2h}
variable enth equal etotal+1*vol/${pv2h}
variable enth equal etotal+1*vol/1602191.7

if "${ens} == nve" then "variable str_ens string 'etotal'"
if "${ens} == nvt" then "variable str_ens string ''"
variable str_ens string ''
if "${ens} == npt" then "variable str_ens string 'vol density'"
if "${ens} == nph" then "variable str_ens string 'vol v_enth'"

thermo_style custom ${str_basic} ${str_ens} cpu cpuremain
thermo_style custom step time pe temp press cella cellb cellc cellalpha cellbeta cellgamma ${str_ens} cpu cpuremain
thermo_style custom step time pe temp press cella cellb cellc cellalpha cellbeta cellgamma  cpu cpuremain
WARNING: New thermo_style command, previous thermo_modify settings will be lost (src/output.cpp:904)
thermo ${nthermo}
thermo 50
thermo_modify flush yes

# ------ Time step ---------------------------------
timestep ${timestep}
timestep 0.001

# ------ Initial velocities and COM motion ---------
if "${runID} == 0" then "velocity free create ${temp} ${iseed0} mom yes dist gaussian"
velocity free create ${temp} ${iseed0} mom yes dist gaussian
velocity free create 1500. ${iseed0} mom yes dist gaussian
velocity free create 1500. 15973 mom yes dist gaussian
fix com all momentum 1000 linear 1 1 1

# ------ Periodic Checkpoint -----------------------
restart 100000 checkpoint.1 checkpoint.2

# ------ Trajectory output -------------------------
if "${ntraj} <= 0 || ${ntraj} > ${nsteps} || ${nsteps} == 0 || ${multiRun} == yes" then "jump SELF end_dump"
  dump traj all ${trajType} ${ntraj} ${traj_file}.${trajType}
  dump traj all dcd ${ntraj} ${traj_file}.${trajType}
  dump traj all dcd 100 ${traj_file}.${trajType}
  dump traj all dcd 100 trajectory.0.${trajType}
  dump traj all dcd 100 trajectory.0.dcd
  dump_modify traj unwrap yes
label end_dump

# ------ Thermodynamic integration -----------------
if "${ti} == no" then "variable nt equal ${nsteps}" "jump SELF end_ti"
variable nt equal ${nsteps}
variable nt equal 100000
jump SELF end_ti

# ------ Free Energy Perturbation ------------------
if "${fep} == no" then "jump SELF end_fep"
jump SELF end_fep

# ------ Multiple Molecular Dynamics ------------------------
if "${multiRun} == no" then "jump SELF end_multi"
jump SELF end_multi

# ------ Molecular Dynamics ------------------------
if "${md} == no && ${plumed} == no" then "jump SELF end_md"
  run ${nsteps}
  run 100000
